{
  // Self-contained compiler settings: types resolve from the @deepseek-ai/*
  // npm SDK packages declared in devDependencies (official NPM SDK), never
  // from a DSH source checkout.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": []
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ],
  // Generated by scripts/build.mjs (git-ignored); a placeholder ships in the
  // repo so typecheck works before the first build.
  "exclude": [
    "src/client/skill-panel.css.ts"
  ]
}
